# ============================================================================
# Blamo Closing — environment variable reference (EXAMPLE ONLY).
#
# Copy this to .env for local runs; the real .env is gitignored. Values here
# are placeholders — never commit real secrets. Both variables below are read
# LAZILY (per call, not at import), matching src/db.ts: the site builds and
# serves fine without them, and a clear error is thrown the first time a query
# or session operation actually runs without them.
# ============================================================================

# --- Database (Neon serverless Postgres) ------------------------------------
# The owner connects a database via the platform's database card, which injects
# DATABASE_URL into the sandbox and passes it to the live host on publish.
# Apply the schema first: db/migrations/001_init.sql
#   (psql "$DATABASE_URL" -f db/migrations/001_init.sql  or the Neon SQL editor)
DATABASE_URL=postgres://user:password@ep-example-000000.us-east-2.aws.neon.tech/neondb?sslmode=require

# --- Sessions -----------------------------------------------------------------
# HMAC signing secret for the stateless session cookie (src/lib/accounts.ts).
# Required once accounts ship. Any long random string, e.g. `openssl rand -hex 32`.
# Keep it secret; rotating it signs everyone out.
SESSION_SECRET=change-me-to-a-long-random-hex-string

# --- Stripe (owner's own account — Path B) -----------------------------------
# Wired up by the Stripe delegation (keys live in the real .env and Vercel env
# vars, never here). Listed as placeholders for completeness.
STRIPE_SECRET_KEY=sk_live_placeholder
STRIPE_PUBLISHABLE_KEY=pk_live_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
